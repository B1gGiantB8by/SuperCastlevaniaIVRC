+                ImGui::GetWindowDrawList()->AddRect(ImGui::GetItemRectMin(),ImGui::GetItemRectMax(),IM_COL32(255,199,50,255),6,0,2);
+        };
+        if(!occupied) ImGui::BeginDisabled();
+        if((appearing || s_sciv_focus_prompt) && s_sciv_prompt_choice==0 && occupied) ImGui::SetKeyboardFocusHere();
+        if(((ImGui::Button("Load",ImVec2(-1,42)) && !appearing) || s_sciv_prompt_action==0) && occupied) {
+            if(snes_savestate_menu_submit_slot(s_sciv_prompt_slot,0)) {
+                m->action=LNG_ACTION_LAUNCH;
+                s_sciv_close_prompt = true;
+            } else snprintf(s_sciv_save_status,sizeof(s_sciv_save_status),"Load failed for slot %02d.",s_sciv_prompt_slot+1);
+        }
+        mark_choice(0);
+        if(!occupied) ImGui::EndDisabled();
+        if((appearing || s_sciv_focus_prompt) && s_sciv_prompt_choice==1) ImGui::SetKeyboardFocusHere();
+        if((ImGui::Button(occupied ? "Overwrite Save" : "Save",ImVec2(-1,42)) && !appearing) || s_sciv_prompt_action==1) {
+            bool ok=snes_savestate_menu_submit_slot(s_sciv_prompt_slot,1)!=0;
+            snprintf(s_sciv_save_status,sizeof(s_sciv_save_status),ok ? "Saved slot %02d." : "Save failed for slot %02d.",s_sciv_prompt_slot+1);
+            if(ok) s_sciv_close_prompt = true;
