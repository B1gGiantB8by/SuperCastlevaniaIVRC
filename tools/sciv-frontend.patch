+            s_sciv_slots_active = true;
+            s_sciv_focus_slots = true;
+        }
+        ImGui::EndPopup();
+    }
+    ImGui::PopStyleVar(2); ImGui::PopStyleColor(8);
+    draw_standalone_builtin_rom_picker(m,th);
