+        ImGui::Text("%d / %d unlocked     %u / 593 G",unlocked,SCIV_ACHIEVEMENT_COUNT,sciv_achievements_score());
+        if(ImGui::Button("Reset achievements...")) ImGui::OpenPopup("Reset achievements?");
+        ImGui::SetNextWindowPos(ImVec2(size.x*.5f,size.y*.5f),ImGuiCond_Always,ImVec2(.5f,.5f));
+        ImGui::SetNextWindowSize(ImVec2(std::min(440.f,size.x-40.f),0),ImGuiCond_Always);
+        if(ImGui::BeginPopupModal("Reset achievements?",nullptr,ImGuiWindowFlags_AlwaysAutoResize)) {
+            ImGui::TextWrapped("Clear all locally earned achievements and score? Start a new game or Boss Rush to attempt the full-run challenges again.");
+            if(ImGui::Button("Reset all progress")) { if(sciv_achievements_reset()) ImGui::CloseCurrentPopup(); }
+            ImGui::SameLine();
+            if(ImGui::Button("Cancel")) ImGui::CloseCurrentPopup();
+            ImGui::EndPopup();
+        }
+        if(sciv_achievements_error()[0]) ImGui::TextWrapped("%s",sciv_achievements_error());
+        ImGui::BeginChild("##achievements",ImVec2(0,0),ImGuiChildFlags_Borders);
+        for(int i=0;i<SCIV_ACHIEVEMENT_COUNT;i++) {
