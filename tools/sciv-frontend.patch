+static void sciv_choose_slot(int slot) {
+    if(sciv_one_life_active()) return;
+    s_sciv_slot = slot;
+    s_sciv_prompt_slot = slot;
+    s_sciv_save_status[0] = 0;
+    char info[96];
+    s_sciv_prompt_choice = snes_savestate_menu_slot_info(slot,info,sizeof(info)) ? 0 : 1;
+    s_sciv_prompt_action = -1;
+    s_sciv_focus_prompt = true;
+    s_sciv_open_prompt = true;
+    s_sciv_prompt = true;
+}
+// Only the slot list owns slot controls. The left menu and dialog use ImGui nav.
+static bool sciv_save_controller(LauncherModel *m, const SDL_Event &ev) {
+    const bool escape = ev.type == SDL_EVENT_KEY_DOWN && ev.key.key == SDLK_ESCAPE;
+    bool pad = ev.type == SDL_EVENT_GAMEPAD_BUTTON_DOWN;
+    int b = pad ? ev.gbutton.button : -1;
+    if(ev.type==SDL_EVENT_KEY_DOWN && !ev.key.repeat) {
+        switch(ev.key.key) {
+        case SDLK_LEFT: b=SDL_GAMEPAD_BUTTON_DPAD_LEFT; break;
+        case SDLK_RIGHT: b=SDL_GAMEPAD_BUTTON_DPAD_RIGHT; break;
+        case SDLK_UP: b=SDL_GAMEPAD_BUTTON_DPAD_UP; break;
+        case SDLK_DOWN: b=SDL_GAMEPAD_BUTTON_DPAD_DOWN; break;
+        case SDLK_RETURN: b=SDL_GAMEPAD_BUTTON_SOUTH; break;
+        default: break;
+        }
+        pad=b>=0;
+    }
+    if(ev.type==SDL_EVENT_GAMEPAD_AXIS_MOTION && ev.gaxis.axis<=SDL_GAMEPAD_AXIS_LEFTY) {
+        static int direction[2]={0,0};
+        const int axis=ev.gaxis.axis;
+        const int next=ev.gaxis.value>16000 ? 1 : ev.gaxis.value < -16000 ? -1 : 0;
+        const bool edge=next && next!=direction[axis];
+        direction[axis]=next;
+        if(edge) {
+            b=axis==SDL_GAMEPAD_AXIS_LEFTX ? (next>0 ? SDL_GAMEPAD_BUTTON_DPAD_RIGHT : SDL_GAMEPAD_BUTTON_DPAD_LEFT)
+                                              : (next>0 ? SDL_GAMEPAD_BUTTON_DPAD_DOWN : SDL_GAMEPAD_BUTTON_DPAD_UP);
+            pad=true;
+        }
+    }
+    if (s_sciv_prompt) {
+        if (escape || b == SDL_GAMEPAD_BUTTON_EAST) {
+            s_sciv_close_prompt = true;
+            return true;
+        }
+        const bool up = b==SDL_GAMEPAD_BUTTON_DPAD_UP || (ev.type==SDL_EVENT_KEY_DOWN && ev.key.key==SDLK_UP);
+        const bool down = b==SDL_GAMEPAD_BUTTON_DPAD_DOWN || (ev.type==SDL_EVENT_KEY_DOWN && ev.key.key==SDLK_DOWN);
+        if(up || down) {
+            char info[96];
+            const bool occupied=snes_savestate_menu_slot_info(s_sciv_prompt_slot,info,sizeof(info))!=0;
+            do { s_sciv_prompt_choice=(s_sciv_prompt_choice+(down ? 1 : 2))%3; }
+            while(!occupied && s_sciv_prompt_choice==0);
+            s_sciv_focus_prompt=true;
+            return true;
+        }
+        if(b==SDL_GAMEPAD_BUTTON_SOUTH || (ev.type==SDL_EVENT_KEY_DOWN && (ev.key.key==SDLK_RETURN || ev.key.key==SDLK_SPACE))) {
+            s_sciv_prompt_action=s_sciv_prompt_choice;
+            return true;
+        }
+        return false;
+    }
+    if (!m->in_session || s_sciv_page != 5 || !pad) return false;
+    if (s_sciv_slots_active && (b == SDL_GAMEPAD_BUTTON_DPAD_LEFT || b == SDL_GAMEPAD_BUTTON_EAST)) {
+        s_sciv_slots_active = false;
+        s_sciv_focus_slots = false;
+        s_sciv_nav_item = s_sciv_page;
+        s_sciv_focus_nav = true;
+        return true;
+    }
+    if (!s_sciv_slots_active && b == SDL_GAMEPAD_BUTTON_DPAD_RIGHT) {
+        if (s_sciv_nav_item == 9) return true;
+        s_sciv_slots_active = true;
+        s_sciv_focus_slots = true;
+        return true;
+    }
+    if (!s_sciv_slots_active) {
+        if(b==SDL_GAMEPAD_BUTTON_DPAD_UP || b==SDL_GAMEPAD_BUTTON_DPAD_DOWN) {
+            s_sciv_nav_item=(s_sciv_nav_item+(b==SDL_GAMEPAD_BUTTON_DPAD_DOWN ? 1 : 9))%10;
+            s_sciv_focus_nav=true;
+            return true;
+        }
+        if(b==SDL_GAMEPAD_BUTTON_SOUTH) {
+            if(s_sciv_nav_item==9) { m->action=LNG_ACTION_QUIT; return true; }
+            s_sciv_page=s_sciv_nav_item;
+            s_sciv_focus_options=true;
+            if(s_sciv_page==5) { s_sciv_slots_active=true; s_sciv_focus_slots=true; }
+            return true;
+        }
+        return false;
+    }
+    if (b == SDL_GAMEPAD_BUTTON_DPAD_DOWN || b == SDL_GAMEPAD_BUTTON_DPAD_UP) {
+        s_sciv_slot = (s_sciv_slot + (b == SDL_GAMEPAD_BUTTON_DPAD_DOWN ? 1 : SNES_SAVESTATE_SLOTS-1)) % SNES_SAVESTATE_SLOTS;
+        s_sciv_save_status[0] = 0;
+        s_sciv_focus_slots = true;
+        return true;
+    }
+    if (b == SDL_GAMEPAD_BUTTON_SOUTH) {
+        sciv_choose_slot(s_sciv_slot);
+        return true;
+    }
+    return false;
+}
+extern "C" void sciv_open_save_states(void) {
+    s_sciv_page = 5;
+    s_sciv_slots_active = true;
+    s_sciv_focus_slots = true;
+    s_sciv_save_status[0] = 0;
+}
+static void sciv_begin_frontend(void) {
+    sciv_achievements_menu_opened();
+    s_sciv_rewind_pad_capture=false;
+    // A window close can bypass the dialog's Back button.
+    s_sciv_prompt=false;
+    s_sciv_open_prompt=false;
+    s_sciv_close_prompt=false;
+    s_sciv_prompt_action=-1;
+    s_sciv_focus_nav=false;
+    s_sciv_focus_options=false;
+    s_sciv_slots_active=s_sciv_page==5;
+    s_sciv_focus_slots=s_sciv_slots_active;
+}
