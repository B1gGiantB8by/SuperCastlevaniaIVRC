+static const char* sciv_rewind_config(void) {
+    return g_launcher_config_path && g_launcher_config_path[0] ? g_launcher_config_path : "config.ini";
+}
+static void sciv_rewind_pad_label(char *out,size_t cap) {
+    snprintf(out,cap,"L2");
+    FILE *f=fopen(sciv_rewind_config(),"r");
+    if(!f) return;
+    char line[256]; bool section=false;
+    while(fgets(line,sizeof(line),f)) {
+        if(line[0]=='[') {section=!strncmp(line,"[GamepadMap]",12);continue;}
+        if(!section) continue;
+        char key[64],value[96]={0};
+        if(sscanf(line," %63[^= ] = %95[^\r\n]",key,value)>=1 && !strcmp(key,"Rewind")) {
+            snprintf(out,cap,"%s",value[0] ? value : "Unbound");break;
+        }
+    }
+    fclose(f);
+}
+static bool sciv_rewind_capture_event(LauncherModel *m,const SDL_Event &ev) {
+    if(!s_sciv_rewind_pad_capture) return false;
+    if(m->capturing || m->hk_capturing || m->view!=LNG_VIEW_CONTROLLER) {
+        s_sciv_rewind_pad_capture=false;return false;
+    }
+    const char *token=nullptr;
+    if(ev.type==SDL_EVENT_KEY_DOWN) {
+        if(ev.key.key==SDLK_ESCAPE) {s_sciv_rewind_pad_capture=false;return true;}
+        if(ev.key.key==SDLK_BACKSPACE) token="";
+        else return true;
+    }
+    if(ev.type==SDL_EVENT_GAMEPAD_BUTTON_DOWN) {
+        static const char *names[]={"A","B","X","Y","Back","Guide","Start","L3","R3","Lb","Rb","DpadUp","DpadDown","DpadLeft","DpadRight"};
+        if(ev.gbutton.button>=0 && ev.gbutton.button<15) token=names[ev.gbutton.button];
+    }
+    if(ev.type==SDL_EVENT_GAMEPAD_AXIS_MOTION && ev.gaxis.value>16000) {
+        if(ev.gaxis.axis==SDL_GAMEPAD_AXIS_LEFT_TRIGGER) token="L2";
+        if(ev.gaxis.axis==SDL_GAMEPAD_AXIS_RIGHT_TRIGGER) token="R2";
+    }
+    if(token) {
+        launcher_ini_kv_write(sciv_rewind_config(),"GamepadMap","Rewind",token);
+        s_sciv_rewind_pad_capture=false;
+    }
+    return ev.type==SDL_EVENT_GAMEPAD_BUTTON_DOWN || ev.type==SDL_EVENT_GAMEPAD_BUTTON_UP || ev.type==SDL_EVENT_GAMEPAD_AXIS_MOTION || ev.type==SDL_EVENT_KEY_UP;
+}
+static void draw_sciv_rewind(LauncherModel *m,const LauncherTheme &th) {
+    if(!m->has_rewind_depth) return;
+    if(begin_panel("sciv-rewind",0)) {
+        ImGui::TextColored(col(th.accent2),"REWIND");
+        bool enabled=m->s.rewind_enabled!=0;
+        if(ImGui::Checkbox("Enable rewind",&enabled)) {
+            launcher_model_toggle_rewind_enabled(m);
+            launcher_ini_kv_write(sciv_rewind_config(),"Rewind","Enabled",enabled ? "1" : "0");
+        }
+        ImGui::TextWrapped("Hold your rewind binding to move back through gameplay. Release it to resume. Bindings stay saved when rewind is disabled.");
+        ImGui::Spacing();
+        ImGui::TextUnformatted("Keyboard"); ImGui::SameLine(px(150));
+        const bool key_capture=m->hk_capturing && m->capture_hk==LNG_HK_REWIND;
+        const char *key=m->hotkeys[LNG_HK_REWIND];
+        if(ImGui::Button(key_capture ? "Press a key..." : key[0] ? key : "Unbound",ImVec2(px(220),px(36)))) {
+            s_sciv_rewind_pad_capture=false;
+            launcher_model_begin_hk_capture(m,LNG_HK_REWIND);
+        }
+        ImGui::TextUnformatted("Controller"); ImGui::SameLine(px(150));
+        char label[96];sciv_rewind_pad_label(label,sizeof(label));
+        if(ImGui::Button(s_sciv_rewind_pad_capture ? "Press button / trigger..." : label,ImVec2(px(220),px(36)))) {
+            launcher_model_cancel_capture(m);
+            launcher_model_cancel_hk_capture(m);
+            s_automap_i=s_automap_player=-1;
+            s_sciv_rewind_pad_capture=true;
+        }
+        if(key_capture || s_sciv_rewind_pad_capture)
+            ImGui::TextColored(col(th.accent2),"Esc cancels. Backspace clears the binding.");
+    } end_panel();
+}
