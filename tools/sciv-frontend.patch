+            if(!a->id && s_sciv_achievement_card.id) ImGui::Image(tid(s_sciv_achievement_card),ImVec2(48,48),ImVec2(.099f,.359f),ImVec2(.194f,.674f));
+            else if(s_sciv_badges[i].id) ImGui::Image(tid(s_sciv_badges[i]),ImVec2(48,48),ImVec2(0,0),ImVec2(1,1),ImVec4(1,1,1,earned ? 1.f : .4f),ImVec4(0,0,0,0));
+            else ImGui::Dummy(ImVec2(48,48));
+            ImGui::SameLine(); ImGui::BeginGroup();
+            ImGui::TextColored(earned ? ImVec4(1,.78f,.3f,1) : ImVec4(.75f,.75f,.8f,1),"%s   %u G",a->name,a->points);
+            ImGui::PushTextWrapPos(ImGui::GetWindowWidth()-15);
+            ImGui::TextUnformatted(a->description);
+            ImGui::PopTextWrapPos();
+            ImGui::TextDisabled("%s",earned ? "Unlocked" : "Locked");
+            ImGui::EndGroup(); ImGui::Separator(); ImGui::PopID();
+        }
+        ImGui::EndChild();
+    }
+    ImGui::EndChild();
+    bool skip_launcher=m->s.skip_launcher!=0;
+    if(ImGui::Checkbox("Skip launcher on boot",&skip_launcher))
+        m->s.skip_launcher=skip_launcher ? 1 : 0;
+    if(ImGui::IsItemHovered())
+        ImGui::SetTooltip("Start directly in the game next time. Open the in-game settings to show the launcher again.");
+    ImGui::TextDisabled(page==5 && m->in_session ? "D-pad: Navigate    A: Choose    Left / B: Menu    Esc: Resume" : "D-pad / Stick: Navigate    A: Select    B / Esc: Resume");
+    ImGui::End();
+    if(s_sciv_open_prompt) {
+        ImGui::OpenPopup("Save State Actions");
+        s_sciv_open_prompt = false;
+    }
+    ImGui::SetNextWindowPos(ImVec2(size.x*.5f,size.y*.5f),ImGuiCond_Always,ImVec2(.5f,.5f));
+    ImGui::SetNextWindowSize(ImVec2(std::min(430.f,size.x-40.f),std::min(360.f,size.y-40.f)),ImGuiCond_Always);
+    if(ImGui::BeginPopupModal("Save State Actions",nullptr,ImGuiWindowFlags_NoResize|ImGuiWindowFlags_NoMove|ImGuiWindowFlags_NoSavedSettings)) {
+        char info[96];
+        bool occupied=snes_savestate_menu_slot_info(s_sciv_prompt_slot,info,sizeof(info))!=0;
+        ImGui::Text("Slot %02d",s_sciv_prompt_slot+1);
