+        mark_choice(1);
+        if((appearing || s_sciv_focus_prompt) && s_sciv_prompt_choice==2) ImGui::SetKeyboardFocusHere();
+        if((ImGui::Button("Back",ImVec2(-1,42)) && !appearing) || s_sciv_prompt_action==2) s_sciv_close_prompt = true;
