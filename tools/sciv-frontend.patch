+// The remapping editor shares the game's artwork, palette and navigation.
+static void draw_sciv_controls(LauncherModel *m, const LauncherTheme &base) {
+    const ImVec2 size=ImGui::GetIO().DisplaySize;
+    auto *bg=ImGui::GetBackgroundDrawList();
+    if(g_sciv_background.id) {
+        const float scale=std::max(size.x/2048.f,size.y/1470.f);
+        const ImVec2 extent(2048.f*scale,1470.f*scale);
+        const ImVec2 origin((size.x-extent.x)*.5f,(size.y-extent.y)*.5f);
+        bg->AddImage(tid(g_sciv_background),origin,ImVec2(origin.x+extent.x,origin.y+extent.y));
+    }
+    bg->AddRectFilled(ImVec2(0,0),size,IM_COL32(7,5,18,130));
+    LauncherTheme th=base;
+    th.panel=lng_rgba(.055f,.035f,.08f,.96f);
+    th.border=lng_rgba(.45f,.30f,.18f,1);
+    th.accent=lng_rgba(.65f,.10f,.14f,1);
+    th.accent2=lng_rgba(1,.78f,.3f,1);
+    th.text_muted=lng_rgba(.83f,.78f,.68f,1);
+    th.focus_ring=th.accent2;
+    const float width=std::min(size.x*.94f,px(1120));
+    ImGui::SetNextWindowPos(ImVec2((size.x-width)*.5f,size.y*.04f),ImGuiCond_Always);
+    ImGui::SetNextWindowSize(ImVec2(width,size.y*.92f),ImGuiCond_Always);
+    ImGui::PushStyleColor(ImGuiCol_WindowBg,ImVec4(.035f,.025f,.065f,.96f));
+    ImGui::PushStyleColor(ImGuiCol_Button,ImVec4(.30f,.045f,.065f,1));
+    ImGui::PushStyleColor(ImGuiCol_ButtonHovered,ImVec4(.50f,.08f,.11f,1));
+    ImGui::PushStyleColor(ImGuiCol_ButtonActive,ImVec4(.65f,.10f,.14f,1));
+    ImGui::PushStyleColor(ImGuiCol_Header,ImVec4(.40f,.07f,.10f,1));
+    ImGui::PushStyleColor(ImGuiCol_NavCursor,ImVec4(1,.78f,.3f,1));
+    ImGui::PushStyleColor(ImGuiCol_FrameBg,ImVec4(.16f,.10f,.16f,1));
+    ImGui::PushStyleColor(ImGuiCol_SliderGrab,ImVec4(1,.78f,.3f,1));
+    ImGui::PushStyleColor(ImGuiCol_ChildBg,ImVec4(.055f,.035f,.08f,.96f));
+    ImGui::PushStyleColor(ImGuiCol_CheckMark,ImVec4(1,.78f,.3f,1));
+    ImGui::PushStyleVar(ImGuiStyleVar_WindowRounding,16);
+    ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding,6);
+    ImGui::Begin("##sciv-controls",nullptr,ImGuiWindowFlags_NoDecoration|ImGuiWindowFlags_NoMove|ImGuiWindowFlags_NoSavedSettings);
+    if(ImGui::Button("Back to Controls",ImVec2(px(180),px(36))) ||
+       (!m->capturing && !m->hk_capturing && !s_sciv_rewind_pad_capture && ImGui::IsKeyPressed(ImGuiKey_Escape))) {
+        launcher_model_cancel_capture(m);
+        launcher_model_cancel_hk_capture(m);
+        s_sciv_rewind_pad_capture=false;
+        s_automap_i=s_automap_player=-1;
+        s_sciv_page=3;
+        s_sciv_focus_options=true;
+        launcher_model_set_view(m,LNG_VIEW_DASHBOARD);
+    }
+    ImGui::SameLine();
+    ImGui::TextColored(ImVec4(1,.78f,.3f,1),"CONTROL CONFIGURATION");
+    ImGui::Separator();
+    ImGui::BeginChild("##sciv-binding-editor",ImVec2(0,-px(40)),ImGuiChildFlags_NavFlattened);
+    draw_sciv_rewind(m,th);
+    draw_controller_config_view(m,th);
+    ImGui::EndChild();
+    ImGui::TextColored(ImVec4(.83f,.78f,.68f,1),"Arrows / D-pad: navigate   Enter / A: select   Esc: cancel capture");
+    ImGui::End();
+    ImGui::PopStyleVar(2);
+    ImGui::PopStyleColor(10);
+}
