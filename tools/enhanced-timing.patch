+/* Host preference; deliberately outside serialized architectural state. */
+#ifdef __cplusplus
+extern "C" {
+#endif
+extern unsigned snes_cpu_timing_divisor;
+static inline uint64_t snes_cpu_timing_clocks(uint64_t clocks) {
+    return snes_cpu_timing_divisor == 1 ? clocks : (clocks + 1) / 2;
