+  host_report_breadcrumb("hold rewind OPEN");
+  while (*running && g_rewind_held) {
+    PumpOverlayEvents(running, HeldRewindKeyDown);
+    /* A lost window or disconnected controller must never trap the guest. */
+    if (!(SDL_GetWindowFlags(g_window) & SDL_WINDOW_INPUT_FOCUS))
+      g_rewind_held = false;
+    if (!*running || !g_rewind_held) break;
+    if (HeldRewindStep()) steps++;
