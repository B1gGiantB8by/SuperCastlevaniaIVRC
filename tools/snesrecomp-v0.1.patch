+  SetAudioPaused(g_paused);
+  g_state_generation = RtlStateGeneration();
+  OverlayNoteClosed();
+  host_report_breadcrumb("hold rewind CLOSED after %u steps - guest resuming", steps);
+  GameReset();
+}
